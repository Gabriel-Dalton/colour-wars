# Copy this file to .env.local and fill in your own values.
# Both variables are NEXT_PUBLIC_ prefixed, so they are compiled into the
# browser bundle and are not secrets. Security for these relies on Row Level
# Security being enabled on every Supabase table, not on keeping them hidden.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=